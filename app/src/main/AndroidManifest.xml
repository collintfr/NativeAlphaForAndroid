<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.cylonid.nativealpha">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />


    <application
        android:name="com.cylonid.nativealpha.util.App"
        android:allowBackup="true"
        android:icon="@mipmap/native_alpha"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/native_alpha"
        android:supportsRtl="true"
        android:screenOrientation="portrait"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:fullBackupContent="true">

        <activity
            android:name="com.cylonid.nativealpha.MainActivity"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.Launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

<!--    All web apps run in BrowserActivity (GeckoView). The aliases keep shortcuts created by
        earlier versions (which targeted WebViewActivity / __WebViewActivity_N) working.-->
        <activity
            android:name="com.cylonid.nativealpha.browser.BrowserActivity"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:icon="@mipmap/native_alpha"
            android:roundIcon="@mipmap/native_alpha"
            android:theme="@style/AppTheme.WebView"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|uiMode|keyboard|keyboardHidden|navigation"
            android:launchMode="standard"
            android:documentLaunchMode="intoExisting"
            android:exported="false" />
        <activity-alias
            android:name=".WebViewActivity"
            android:targetActivity="com.cylonid.nativealpha.browser.BrowserActivity" />
        <activity-alias
            android:name=".__WebViewActivity_0"
            android:targetActivity="com.cylonid.nativealpha.browser.BrowserActivity" />
        <activity-alias
            android:name=".__WebViewActivity_1"
            android:targetActivity="com.cylonid.nativealpha.browser.BrowserActivity" />
        <activity-alias
            android:name=".__WebViewActivity_2"
            android:targetActivity="com.cylonid.nativealpha.browser.BrowserActivity" />
        <activity-alias
            android:name=".__WebViewActivity_3"
            android:targetActivity="com.cylonid.nativealpha.browser.BrowserActivity" />
        <activity-alias
            android:name=".__WebViewActivity_4"
            android:targetActivity="com.cylonid.nativealpha.browser.BrowserActivity" />
        <activity-alias
            android:name=".__WebViewActivity_5"
            android:targetActivity="com.cylonid.nativealpha.browser.BrowserActivity" />
        <activity-alias
            android:name=".__WebViewActivity_6"
            android:targetActivity="com.cylonid.nativealpha.browser.BrowserActivity" />
        <activity-alias
            android:name=".__WebViewActivity_7"
            android:targetActivity="com.cylonid.nativealpha.browser.BrowserActivity" />

        <activity
            android:name="com.cylonid.nativealpha.browser.AdblockDashboardActivity"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|uiMode"
            android:theme="@style/AppTheme" />

        <activity
            android:name="com.cylonid.nativealpha.SettingsActivity"
            android:parentActivityName=".MainActivity"
            android:icon="@mipmap/native_alpha"
            android:roundIcon="@mipmap/native_alpha"
            android:theme="@style/AppTheme">
        </activity>
        <activity
            android:name="com.cylonid.nativealpha.WebAppSettingsActivity"
            android:parentActivityName=".MainActivity"
            android:icon="@mipmap/native_alpha"
            android:roundIcon="@mipmap/native_alpha"
            android:theme="@style/AppTheme">
        </activity>

        <activity
            android:name="com.cylonid.nativealpha.AboutActivity"
            android:parentActivityName=".MainActivity"
            android:icon="@mipmap/native_alpha"
            android:roundIcon="@mipmap/native_alpha"
            android:theme="@style/AppTheme">
        </activity>

        <activity
            android:name="com.cylonid.nativealpha.activities.NewsActivity"
            android:parentActivityName=".MainActivity"
            android:icon="@mipmap/native_alpha"
            android:roundIcon="@mipmap/native_alpha"
            android:theme="@style/AppTheme">
        </activity>

        <activity android:name="com.mikepenz.aboutlibraries.ui.LibsActivity"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">
        </activity>


        <receiver
            android:name="com.cylonid.nativealpha.util.ShortcutPinnedReceiver"
            android:exported="false" />

        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true"/>
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true"/>
        <!--        https://developer.samsung.com/samsung-dex/modify-optimizing.html-->
    </application>

</manifest>